{
  "name": "formradar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cl": "node model/champions.mjs && node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "model:setup": "node model/setup.mjs",
    "model:import": "node model/import.mjs",
    "model:validate": "node model/import.mjs --validate",
    "model:train": "node model/run.mjs evaluate",
    "model:inspect": "node model/run.mjs inspect",
    "model:refit": "node model/run.mjs refit",
    "model:prepare-current": "node model/current.mjs",
    "model:prepare-cl": "node model/champions.mjs",
    "model:test": "node model/run.mjs test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
