# Server only. Get your own token: https://www.football-data.org/client/register
# Never prefix this variable with VITE_. Never commit .env.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# News Radar: get your own developer key from https://open-platform.theguardian.com/access/
# Server-only, headline/link context. News does not currently alter model probabilities.
GUARDIAN_API_KEY=
# Optional starting-XI source: https://dashboard.api-football.com/
# Check current-season coverage on your plan before buying anything.
API_FOOTBALL_KEY=
# Vercel: shared private model/history storage, cache and request budgets.
# Connect an Upstash Redis store; keep the write token server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use this same namespace locally when publishing and in the production project.
FORMRADAR_CLOUD_NAMESPACE=formradar-production
# Existing FormRadar/.env is loaded as a fallback; no need to copy the token.
# Defaults below are optional. Keep loopback binding for local use.
HOST=127.0.0.1
API_PORT=3001
DEV_PORT=5173
PORT=3000
