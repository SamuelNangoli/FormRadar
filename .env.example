# Server only. Get your own token: https://www.football-data.org/client/register
# Never prefix this variable with VITE_. Never commit .env.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# News Radar: get your own developer key from https://open-platform.theguardian.com/access/
# Server-only, headline/link context. News does not currently alter model probabilities.
GUARDIAN_API_KEY=
# Existing FormRadar/.env is loaded as a fallback; no need to copy the token.
# Defaults below are optional. Keep loopback binding for local use.
HOST=127.0.0.1
API_PORT=3001
DEV_PORT=5173
PORT=3000
